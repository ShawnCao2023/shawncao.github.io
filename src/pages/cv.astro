---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const cv = await getEntry("pages", "cv");

if (!cv) {
  throw new Error("Missing content entry: `src/content/pages/cv.md`");
}

const { Content } = await render(cv);
---

<Layout
  title={`${cv.data.title} | ${config.site.title}`}
  description={cv.data.description}
>
  <Header />
  <Breadcrumb />
  <Main pageTitle={cv.data.title} class="app-prose">
    <Content />
  </Main>
  <Footer />
</Layout>
