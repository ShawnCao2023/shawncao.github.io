---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { publications } from "@/data/publications";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout
  title={`Publications | ${config.site.title}`}
  description="Selected publications by Xiaoxu Cao."
>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle="Publications"
    pageDesc="Selected research in robotics, vehicle dynamics, planning, and control."
  >
    <ol class="space-y-7">
      {
        publications.map(publication => (
          <li class="border-border border-b pb-7 last:border-0">
            <p class="text-muted-foreground mb-1 text-sm">
              {publication.year} · {publication.venue}
            </p>
            <h2 class="text-lg leading-7 font-semibold">
              <a
                href={getRelativeLocaleUrl(
                  locale,
                  `publication/${publication.slug}`
                )}
                class="hover:text-accent underline decoration-dashed underline-offset-4"
              >
                {publication.title}
              </a>
            </h2>
          </li>
        ))
      }
    </ol>
  </Main>
  <Footer />
</Layout>
